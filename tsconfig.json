{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "noImplicitAny": false,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "outDir": "dist/js",
        "noEmitOnError": false,
        "typeRoots": [ "node_modules/@types", "src/types/defs" ],
        "resolveJsonModule": true,
        "jsx": "react",
        "lib": [
            "es2021",
            "dom",
            "dom.iterable"
        ]
    }
}